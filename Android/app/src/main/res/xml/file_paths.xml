<?xml version="1.0" encoding="utf-8"?>
<!--
  Roots FAShareBridge may hand out URIs for. `generateLogFile` writes to
  FileManager.default.temporaryDirectory, which SkipFoundation maps into the app's
  private storage; both roots are declared so the mapping can change without
  breaking the share.
-->
<paths>
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
</paths>
