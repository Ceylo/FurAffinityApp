#!/bin/bash
#
# swift-frontend of the FA Compilation Cache toolchain, installed there by
# Scripts/iOS/compilation-cache-toolchain.sh; the real one sits next to it.
#
# The toolchain's prefix maps (/^src, /^derived, …) make a cache key independent
# of the worktree, except for what Xcode 26.6's driver leaves unmapped in each
# cached job. This maps those too, before the frontend computes the key. A job
# that is not cached is passed through untouched.

PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"   # md5, perl, mkdir: Xcode may hand us a bare environment
real="${BASH_SOURCE[0]%/*}/swift-frontend-real"
llvm_cas="${BASH_SOURCE[0]%/*}/llvm-cas"
# The canvas's compile runs with HOME unset: the toolchain's own path knows the home.
home="${HOME:-${BASH_SOURCE[0]%%/Library/Developer/Toolchains/*}}"
scratch="$home/Library/Caches/FACompilationCache"
set -o pipefail   # a failed cat-blob must not memoize an empty module map

[[ " $* " == *" -cache-compile-job "* ]] || exec -a "$0" "$real" "$@"

args=("$@")
n=${#args[@]}
cas=; pairs=()
for (( i = 0; i < n; i++ )); do
    case "${args[i]}" in
        -cas-path) cas="${args[i+1]}" ;;
        # The driver's own record of the mapping, as placeholder/real pairs.
        -cache-replay-prefix-map) pairs+=("${args[i+1]}" "${args[i+2]}") ;;
    esac
done

# A preview's thunk compile reuses the cached job's mapped command line but opens
# its inputs from disk (-no-cache-compile-job, the later flag, wins), where no
# /^src exists: map every placeholder back to its real path.
if [[ " $* " == *" -no-cache-compile-job "* ]]; then
    for (( i = 0; i < n; i++ )); do
        s="${args[i]}"
        [[ "$s" == llvmcas://* ]] && continue
        for (( j = 0; j < ${#pairs[@]}; j += 2 )); do
            ph="${pairs[j]}" r="${pairs[j+1]}" out=
            while [[ "$s" == *"$ph"* ]]; do
                rest="${s#*"$ph"}"
                if [[ -z "$rest" || "$rest" == [/#]* ]]; then out+="${s%%"$ph"*}$r"; else out+="${s%%"$ph"*}$ph"; fi
                s="$rest"
            done
            s="$out$s"
        done
        args[i]="$s"
        # The source list is a file whose lines carry the placeholders too.
        if (( i == 0 )) || [[ "$s" == *.swift || ${args[i-1]} != -filelist ]]; then continue; fi
        mkdir -p "$scratch/filelists"
        list="$scratch/filelists/$$.$i"
        cp "$s" "$list" || continue
        for (( j = 0; j < ${#pairs[@]}; j += 2 )); do
            ph="${pairs[j]}" r="${pairs[j+1]}"
            perl -i -pe 'BEGIN { ($p, $r) = splice @ARGV, 0, 2 } s/^\Q$p\E(?=\/|$)/$r/' "$ph" "$r" "$list"
        done
        stable="$scratch/filelists/$(md5 -q "$list").txt"   # named by content: no pile-up
        mv -f "$list" "$stable" && args[i]="$stable"
    done
    # Cached .pcm files name their headers by placeholder too: remap those on disk.
    mkdir -p "$scratch/vfs"
    overlay="$scratch/vfs/$$.json"
    {
        printf '{"version":0,"roots":['
        for (( j = 0; j < ${#pairs[@]}; j += 2 )); do
            (( j )) && printf ','
            printf '{"type":"directory-remap","name":"%s","external-contents":"%s"}' "${pairs[j]}" "${pairs[j+1]}"
        done
        printf ']}\n'
    } > "$overlay"
    stable="$scratch/vfs/$(md5 -q "$overlay").json"
    mv -f "$overlay" "$stable"
    # Ahead of Xcode's own overlay, which swaps the source for the thunk: a later
    # overlay shadows it, the source compiles instead, and its #Preview registry
    # duplicates the app's, so the canvas never finds the thunk's.
    for (( i = 1; i < n; i++ )); do [[ "${args[i]}" == -vfsoverlay ]] && break; done
    exec -a "$0" "$real" "${args[@]:0:i}" -vfsoverlay "$stable" "${args[@]:i}"
fi

for (( i = 0; i < n - 1; i++ )); do
    case "${args[i]}" in
        -debug-module-path|-module-cache-path)
            v="${args[i+1]}"
            for (( j = 0; j < ${#pairs[@]}; j += 2 )); do
                ph="${pairs[j]}" r="${pairs[j+1]}"
                if [[ "$v" == "$r"/* ]]; then args[i+1]="$ph${v#"$r"}"; break; fi
            done ;;
        -const-gather-protocols-file)
            # Read from disk rather than from the CAS, so it needs a real path:
            # one named by its content is the same in every worktree.
            v="${args[i+1]}"
            [[ -f "$v" ]] || continue
            stable="$scratch/const-protocols/$(md5 -q "$v").json"
            if [[ ! -f "$stable" ]]; then
                mkdir -p "${stable%/*}" && cp "$v" "$stable.$$" && mv -f "$stable.$$" "$stable"
            fi
            args[i+1]="$stable" ;;
        -explicit-swift-module-map-file)
            # A JSON blob in the CAS whose modulePath entries are unmapped. Modules
            # load by their moduleCacheKey, so those paths are only labels: map
            # them, keep the result on disk named by its content, and store it back
            # every time, since a pruned CAS may have lost it.
            id="${args[i+1]}"
            [[ "$id" == llvmcas://* && -n "$cas" ]] || continue
            memo="$scratch/module-maps/by-id/${id#llvmcas://}"
            stable=; [[ -f "$memo" ]] && read -r stable < "$memo"
            if [[ ! -f "$stable" ]]; then
                mkdir -p "${memo%/*}"
                tmp="$scratch/module-maps/$$.json"
                "$llvm_cas" --cas="$cas" --cat-blob "$id" | perl -0777 -pe '
                    BEGIN { our %m = @ARGV; @ARGV = () } our %m;
                    for my $ph (keys %m) {
                        (my $r = $m{$ph}) =~ s{/}{\\/}g; (my $p = $ph) =~ s{/}{\\/}g;
                        s/\Q$r\E(?=\\\/|")/$p/g; s/\Q$m{$ph}\E(?=\/|")/$ph/g;
                    }
                    # A module built from its interface is named after a hash of its
                    # unmapped context.
                    s{(SwiftExplicitPrecompiledModules\\?/\w+)-[A-Z0-9]+\.swiftmodule}{$1.swiftmodule}g;
                ' "${pairs[@]}" > "$tmp" || { rm -f "$tmp"; continue; }
                stable="$scratch/module-maps/$(md5 -q "$tmp").json"
                mv -f "$tmp" "$stable"
                echo "$stable" > "$memo.$$" && mv -f "$memo.$$" "$memo"
            fi
            args[i+1]="$("$llvm_cas" --cas="$cas" --make-blob --data "$stable")" || args[i+1]="$id" ;;
    esac
done

# Skeleton CUs name each imported Clang module's .pcm by its mapped path, which the
# debugger cannot open; without them it finds those types through its Clang importer.
[[ "${args[1]}" == -c ]] && args+=(-no-clang-module-breadcrumbs)

exec -a "$0" "$real" "${args[@]}"
