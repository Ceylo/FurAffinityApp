// The configuration file for your Skip App (https://skip.dev).
// Properties specified here are shared between
// Darwin/FurAffinityUI.xcconfig and Android/settings.gradle.kts
// and will be included in the app's metadata files
// Info.plist and AndroidManifest.xml

// PRODUCT_NAME is the default title of the app, which must match the app's Swift module name
PRODUCT_NAME = FurAffinityUI

// PRODUCT_BUNDLE_IDENTIFIER is the unique id for both the iOS and Android app.
// Skip's Gradle plugin derives Android's applicationId from it. The real one
// (ceylo.FurAffinity, matching the iOS bundle id) lives in the
// "📱For App Store distribution" stash alongside the .xcodeproj's, so a clone of
// this repo can't build something that collides with the shipped app.
PRODUCT_BUNDLE_IDENTIFIER = com.example.id1234

// The semantic version of the app. Becomes versionName on Android; keep it equal
// to MARKETING_VERSION in project.pbxproj and bump both at each release.
MARKETING_VERSION = 1.19

// The build number specifying the internal app version. Becomes Android's
// versionCode, which must never regress, so it is derived from the semantic
// version: major*10000 + minor*100 + patch (1.19 → 11900, 1.16.3 → 11603).
CURRENT_PROJECT_VERSION = 11900

// The package name for the Android entry point, referenced by the AndroidManifest.xml
ANDROID_PACKAGE_NAME = fur.affinity.ui

// If your Android appId is different from the iOS Bundle Identifer, specify it here
// ANDROID_APPLICATION_ID = com.example.id1234
